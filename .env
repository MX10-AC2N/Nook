# === Backend ===
PORT=3000
DATABASE_URL=sqlite:/app/data/nook.db
STATIC_FILES_DIR=/app/static
UPLOADS_DIR=/app/data/uploads

# === URL publique (utilisée par le frontend pour WebRTC, base href, etc.) ===
PUBLIC_SITE_URL=http://192.168.1.192:6300

# === Logging ===
RUST_LOG=info
RUST_BACKTRACE=1
TZ=Europe/Paris