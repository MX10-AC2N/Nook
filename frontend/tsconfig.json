{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    // Autorise les fichiers *.js et *.ts dans le projet
    "allowJs": true,
    "checkJs": true,

    // Compatibilité ES‑Modules + interop avec les packages CommonJS
    "esModuleInterop": true,

    // Enforce le respect de la casse des chemins de fichiers
    "forceConsistentCasingInFileNames": true,

    // Permet d’importer des fichiers JSON directement
    "resolveJsonModule": true,

    // Accélère la compilation en ignorant les vérifications de lib
    "skipLibCheck": true,

    // Génère les sourcemaps (utile en dev)
    "sourceMap": true,

    // Mode strict – meilleure sécurité de type
    "strict": true,

    // Résolution des modules via le bundler (Vite)
    "moduleResolution": "bundler",

    // Utilise les modules ESNext (compatible avec Vite)
    "module": "ESNext",

    // Cible le JavaScript le plus récent
    "target": "ESNext",

    // Bibliothèques disponibles (ESNext + DOM)
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // Types fournis par Vite (pour `import.meta.env`, etc.)
    "types": ["vite/client"],

    // -----------------------------------------------------------------
    // 1️⃣ Aliases – ils permettent d’écrire `$lib/...` au lieu de
    //    chemins relatifs lourds.  Ajoute les alias que tu utilises
    //    dans ton code (ex. `$components`, `$routes`, `$assets`).
    // -----------------------------------------------------------------
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"],
      "$components": ["./src/components"],
      "$components/*": ["./src/components/*"],
      "$routes": ["./src/routes"],
      "$routes/*": ["./src/routes/*"],
      "$assets": ["./static"]
    }
  },

  // -----------------------------------------------------------------
  // 2️⃣ Quels fichiers doivent être analysés par TypeScript ?
  // -----------------------------------------------------------------
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte"
  ],

  // -----------------------------------------------------------------
  // 3️⃣ Exclusions – on ne veut pas que le compilateur scrute
  //    les dossiers générés ou les dépendances externes.
  // -----------------------------------------------------------------
  "exclude": ["node_modules", "build", ".svelte-kit"]
}