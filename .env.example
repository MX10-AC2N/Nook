# === Backend ===
PORT=3000
DATABASE_URL=sqlite:/app/data/nook.db
STATIC_FILES_DIR=/app/static
UPLOADS_DIR=/app/data/uploads

# === URL publique principale (LAN ou WAN selon ton déploiement) ===
# Cette URL est automatiquement ajoutée aux origines CORS autorisées.
PUBLIC_SITE_URL=http://192.168.1.192:6300

# === Origines CORS supplémentaires (séparées par des virgules) ===
# Ajouter ici TOUTES les URLs depuis lesquelles l'app sera accédée :
#   - IP LAN             : http://192.168.1.192:6300
#   - Domaine WAN        : https://nook.mondomaine.com
#   - Autres IPs LAN     : http://192.168.1.50:6300
#
# Note : localhost:5173 et localhost:6300 sont toujours inclus (dev).
# Note : PUBLIC_SITE_URL est aussi toujours inclus.
#
# Exemple :
# ALLOWED_ORIGINS=http://192.168.1.192:6300,https://nook.mondomaine.com
ALLOWED_ORIGINS=http://192.168.1.192:6300

# === Logging ===
RUST_LOG=info
RUST_BACKTRACE=1
TZ=Europe/Paris
