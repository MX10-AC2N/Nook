# Nook Environment Variables
# Copy this to .env and fill in the values

# ── Core ──────────────────────────────────────────
TZ=Europe/Paris
PORT=6300
PUBLIC_SITE_URL=http://localhost:6300
E2E_SETUP=0
RATE_LIMIT_PER_MIN=60

# ── Directories (relative to docker-compose.yml) ──
DATA_DIR=./nook-data
LOGS_DIR=./nook-logs
NGINX_SSL_DIR=./nginx-ssl
TURN_CONFIG_DIR=./turn-config

# ── Security (REQUIRED) ─────────────────────────
TURN_SECRET=your_turn_secret_here
ADMIN_INITIAL_PASSWORD=changeme2026

# ── VAPID (Push Notifications) ──────────────────
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@nook.local

# ── Optional ─────────────────────────────────────
GIPHY_API_KEY=
ALLOWED_ORIGINS=
RUST_LOG=info
RUST_BACKTRACE=0

# ── Resources ───────────────────────────────────
CPUS_LIMIT=1.5
MEMORY_LIMIT=1028M
CPUS_RESERVATION=0.5
MEMORY_RESERVATION=256M

# ── Nginx ───────────────────────────────────────
NGINX_HTTPS_PORT=6443
HOST_IP=

# ── TURN Server ─────────────────────────────────
TURN_PORT=3478
