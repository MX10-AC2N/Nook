# ============================================================
# Nook Environment Configuration Template - COMPLETE
# ============================================================
# Copy this file to .env and customize as needed
# 
#   On your Zimaboard homeserver:
#     cp .env.example .env
#     → Edit the values below for your setup
#
#   For local development:
#     cp .env.example .env
#     → Keep the default values (everything works on localhost)
#
# ⚠️  NEVER commit your .env file — it may contain sensitive data.
#     Only .env.example is tracked in this repository.
# ============================================================

# ============================================================
# SERVER & NETWORK CONFIGURATION
# ============================================================
# The port Nook will listen on inside the container (always 3000)
# The host port is mapped via: "HOST_PORT:3000" in docker-compose.yml
PORT=3000

# Timezone for correct date/time display (see: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=Europe/Paris

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# SQLite database file path (relative to /app inside the container)
# The ./nook-data volume is mounted to /app/data, so this becomes:
#   /app/data/nook.db  →  ./nook-data/nook.db on your host
DATABASE_URL=sqlite:/app/data/nook.db

# ============================================================
# FILE STORAGE DIRECTORIES
# ============================================================
# Directory where frontend static files are served from
# (The frontend/ directory is copied to /app/static in the image)
STATIC_FILES_DIR=/app/static

# Directory where user uploads (photos, files, etc.) are stored
# The ./nook-data volume is mounted to /app/data, so:
#   UPLOADS_DIR=/app/data/uploads  →  ./nook-data/uploads on host
UPLOADS_DIR=/app/data/uploads

# Directory where GIFs are stored (used by update-gifs.sh script)
# The ./nook-data volume is mounted to /app/data, so:
#   GIFS_DIR=/app/data/gifs  →  ./nook-data/gifs on host
GIFS_DIR=/app/data/gifs

# ============================================================
# PUBLIC URL & FEATURE FLAGS
# ============================================================
# Public base URL where Nook is accessible (used for federation, emails, etc.)
# MUST be set correctly if you plan to federate with other instances
# Examples: http://your-domain.com, http://192.168.1.100:6300
PUBLIC_SITE_URL=http://localhost:6300

# Enable End-to-End encrypted setup mode (for automated testing only)
# Set to 0 for production, 1 only for CI/E2E tests
E2E_SETUP=0

# Rate limit for API requests (requests per minute per IP)
# Set to 0 to disable rate limiting
RATE_LIMIT_PER_MIN=60

# Initial admin password (used only on first boot if no users exist)
# If not set, a random password will be generated and shown in logs
# WARNING: For security, change this after first login or set via env!
ADMIN_INITIAL_PASSWORD=change_me_after_first_login

# ============================================================
# GIPHY INTEGRATION
# ============================================================
# Giphy API key for GIF search feature
# Get a free key at: https://developers.giphy.com/dashboard/
# Leave empty to disable GIF search (emojis still work)
GIPHY_API_KEY=your_giphy_api_key_here

# ============================================================
# CORS CONFIGURATION
# ============================================================
# Additional allowed origins for CORS (comma-separated list)
# localhost:5173 (Vite dev) and localhost:6300 (docker) are ALWAYS allowed
# PUBLIC_SITE_URL is also automatically added if set
# Example: ALLOWED_ORIGINS=http://192.168.1.100:6300,https://nook.mydomain.com
ALLOWED_ORIGINS=

# ============================================================
# TURN SERVER CONFIGURATION (for WebRTC calls)
# ============================================================
# External port for TURN/UDP and TURN/TCP traffic
# Only change if you need to run on a non-standard port due to firewall restrictions
TURN_PORT=3478

# TURN server secret (used to generate time-limited credentials)
# IMPORTANT: Change this to a random string before production use!
# Generate with: openssl rand -base64 32
TURN_SECRET=change_this_to_a_long_random_secret

# ============================================================
# LOGGING CONFIGURATION
# ============================================================
# Rust logging level (see: https://docs.rs/env_logger/latest/env_logger/)
# Valid values: trace, debug, info, warn, error
# For development: RUST_LOG=debug
# For production: RUST_LOG=info
RUST_LOG=info

# Enable Rust backtraces on panic (1 = yes, 0 = no)
# Only set to 1 for debugging - adds overhead!
RUST_BACKTRACE=0

# ============================================================
# VAPID KEYS FOR PUSH NOTIFICATIONS (Web Push)
# ============================================================
# Generate once with: npx web-push generate-vapid-keys
# OR with OpenSSL:
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#   openssl ec -in vapid_private.pem -pubout -out vapid_public.pem
#
# VAPID_PRIVATE_KEY : private key in base64url format (PKCS8 DER)
# VAPID_PUBLIC_KEY  : uncompressed public key in base64url (65 bytes)
# VAPID_SUBJECT     : mailto: or URL for push service contact
#
# If NOT set, push notifications will be silently disabled (no errors)
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@${HOSTNAME:-nook.local}


# Directory for TURN server configuration
# The container mounts this to /etc/turn-server (read-only), so:
#   place your turnserver.conf in ${TURN_CONFIG_DIR} on host
#   Defaults to ./turn-config relative to the compose file
TURN_CONFIG_DIR=./turn-config
