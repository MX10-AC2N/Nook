# ============================================================
# .env.example — Template de configuration Nook
# ============================================================
# Copier ce fichier et l'adapter à ton environnement :
#
#   Sur le homeserver Zimaboard :
#     cp .env.example .env
#     → adapter DATA_DIR, LOGS_DIR, PUBLIC_SITE_URL, ALLOWED_ORIGINS
#
#   En développement local :
#     cp .env.example .env
#     → laisser les valeurs par défaut (localhost)
#
# ⚠️  Ne jamais committer ton .env — il contient des paths et IPs spécifiques.
#     Seul .env.example est dans le repo.
# ============================================================

# ── Image Docker ──────────────────────────────────────────────
# Défaut compose : ghcr.io/mx10-ac2n/nook:latest
# Fixer une version précise pour éviter les mises à jour surprises :
# NOOK_IMAGE=ghcr.io/mx10-ac2n/nook:v0.1.0
NOOK_IMAGE=ghcr.io/mx10-ac2n/nook:latest

# ── Port exposé sur l'hôte ────────────────────────────────────
HOST_PORT=6300

# ── Volumes — paths des données persistantes ──────────────────
# Homeserver Zimaboard (paths absolus) :
#   DATA_DIR=/votre_chemin/volume_docker_Nook/nook-data
#   LOGS_DIR=/votre_chemin/volume_docker_Nook/nook-logs
# Développement local (chemins relatifs) :
DATA_DIR=./data
LOGS_DIR=./logs

# ── URL publique ──────────────────────────────────────────────
# Automatiquement ajoutée aux origines CORS autorisées.
# Utiliser l'IP ou le domaine depuis lequel l'app est accédée.
PUBLIC_SITE_URL=http://localhost:6300

# ── Origines CORS supplémentaires ─────────────────────────────
# Si l'app est accédée depuis plusieurs URLs (LAN + WAN) :
#   ALLOWED_ORIGINS=http://192.168.1.192:6300,https://nook.mondomaine.com
# localhost:5173, localhost:6300 et PUBLIC_SITE_URL sont toujours inclus.
ALLOWED_ORIGINS=

# ── Logging ───────────────────────────────────────────────────
RUST_LOG=info
RUST_BACKTRACE=1
TZ=Europe/Paris

# ── GIFs (mise à jour hebdomadaire) ──────────────────────────
# Clé Giphy SDK gratuite : https://developers.giphy.com → Create App → SDK
# Utilisée par scripts/update-gifs.sh pour télécharger les GIFs.
# Sans cette clé, le dossier GIFs reste vide (les emojis fonctionnent toujours).
GIPHY_API_KEY=

# Dossier de stockage des GIFs sur le serveur (dans le volume de données).
# Ne pas modifier sauf si vous avez changé les volumes Docker.
# Défaut Docker : /app/data/gifs (mis à jour sans rebuild de l'image)
GIFS_DIR=/app/data/gifs

# ── Notifications push VAPID ──────────────────────────────────
# Génération des clés (une seule fois, sur la machine de déploiement) :
#   npx web-push generate-vapid-keys
#
# Ou avec OpenSSL :
#   openssl ecparam -name prime256v1 -genkey -noout -out vapid_private.pem
#   openssl ec -in vapid_private.pem -pubout -out vapid_public.pem
#
# VAPID_PRIVATE_KEY : clé privée P-256 en base64url (format PKCS8 DER)
# VAPID_PUBLIC_KEY  : clé publique P-256 en base64url uncompressed (65 bytes)
# VAPID_SUBJECT     : mailto: ou URL de contact pour les serveurs push
#
# Si absent : les notifications push sont silencieusement ignorées (pas d'erreur).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@nook.local

# ── TURN/STUN Server ──────────────────────────────────────────
# Secret pour le serveur turn-rs (RFC 5389 long-term credentials).
# Les credentials côté client sont générés dynamiquement via
# HMAC-SHA1(SECRET, username) où username = epoch + validity.
# Changer cette valeur AVANT le déploiement en production.
TURN_SECRET=change_this_to_a_long_random_secret

# ── E2E Setup ─────────────────────────────────────────────────
# Mettre à 1 uniquement pour les tests automatisés (CI).
# En production : laisser à 0.
E2E_SETUP=0
