# Nook Environment Configuration
# Copy this to .env and adjust as needed

# Server configuration
PORT=3000
TZ=Europe/Paris

# Database (SQLite)
DATABASE_URL=sqlite:/app/data/nook.db

# File storage
STATIC_FILES_DIR=/app/static
UPLOADS_DIR=/app/data/uploads

# Public URL (used for federation, emails, etc.)
PUBLIC_SITE_URL=http://localhost:6300

# Feature flags
E2E_SETUP=0
GIPHY_API_KEY=your_giphy_api_key_here

# Resource limits (adjust based on your hardware)
CPUS_LIMIT=1.5
MEMORY_LIMIT=1028M
CPUS_RESERVATION=0.5
MEMORY_RESERVATION=256M

# TURN server port (if changed from default)
TURN_PORT=3478
