# ============================================================
# Nook Environment Configuration
# ============================================================
# Copy this file to .env and customize as needed
# All variables are optional - defaults will be used if not set
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
# Port on which Nook will be accessible (host:container)
PORT=3000

# Timezone for date/time display
TZ=Europe/Paris

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# SQLite database file path (relative to /app in container)
DATABASE_URL=sqlite:/app/data/nook.db

# ============================================================
# FILE STORAGE
# ============================================================
# Directory for static frontend files (served by backend)
STATIC_FILES_DIR=/app/static

# Directory for user uploads (photos, files, etc.)
UPLOADS_DIR=/app/data/uploads

# ============================================================
# PUBLIC URL & FEATURES
# ============================================================
# Public base URL (used for federation, email links, etc.)
# MUST be reachable from other instances if federation is enabled
PUBLIC_SITE_URL=http://localhost:6300

# Enable E2E setup mode (0 = disabled, 1 = enabled)
E2E_SETUP=0

# Giphy API key for GIF search (get one at https://developers.giphy.com/)
# Leave empty to disable GIF search
GIPHY_API_KEY=your_giphy_api_key_here

# ============================================================
# RESOURCE LIMITS (for docker-compose deploy)
# ============================================================
# Adjust these based on your hardware (especially Zimaboard)
# Format: number[unit] where unit can be B, K, M, G
CPUS_LIMIT=1.5
MEMORY_LIMIT=1028M
CPUS_RESERVATION=0.5
MEMORY_RESERVATION=256M

# ============================================================
# TURN SERVER (for WebRTC calls)
# ============================================================
# External port for TURN/UDP and TURN/TCP
# Change only if you need to run on a non-standard port
TURN_PORT=3478
