# ============================================================
# Nook - Turn Server (runtime only, pre-compiled binary)
# ============================================================

FROM alpine:3.21 AS runtime

RUN apk add --no-cache \
    ca-certificates \
    su-exec

# User non-root with UID/GID 1000 (matches host casaos user)
RUN addgroup -S -g 1000 nook && adduser -S -u 1000 -G nook nook

# Create config directories
RUN mkdir -p /etc/turn-server /opt/turn-server

# Copy default configuration template to /opt (NOT mounted)
COPY turnserver.conf.template /opt/turn-server/turnserver.conf.template

# Copy the entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# Copy the pre-compiled turn-server binary
ARG TARGETARCH=amd64
COPY --chmod=755 turn-server-${TARGETARCH} /usr/local/bin/turn-server

WORKDIR /etc/turn-server

EXPOSE 3478/tcp 3478/udp

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD pgrep turn-server || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["/usr/local/bin/turn-server"]
