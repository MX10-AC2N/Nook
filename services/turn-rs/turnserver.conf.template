# ── Turn-Server Configuration (TOML) ──
# Éditer ce fichier pour personnaliser le serveur TURN/STUN
# Après modification : docker compose restart nook-turn

[server]
name = "nook.turn"
secret = "${TURN_SECRET}"
max-threads = 4

[[server.interfaces]]
transport = "udp"
listen = "0.0.0.0:3478"
external = "0.0.0.0:3478"

[[server.interfaces]]
transport = "tcp"
listen = "0.0.0.0:3478"
external = "0.0.0.0:3478"
