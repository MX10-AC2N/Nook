{
  "projectName": "Nook",
  "description": "Messagerie privée familiale self-hosted — Rust/Axum 0.8 + SvelteKit 5 Runes + E2EE + Push VAPID",
  "version": "0.4.0-beta.2",
  "contextFiles": [
    ".hermes/CLAUDE.md",
    ".hermes/BUGS.md",
    ".hermes/rules/architecture.md",
    ".hermes/rules/coding-style.md",
    ".hermes/rules/workflows.md",
    ".hermes/rules/memory-decisions.md",
    ".hermes/rules/memory-preferences.md",
    ".hermes/rules/memory-sessions.md",
    ".hermes/rules/mcp-servers.md"
  ],
  "mcpServers": {
    "svelte": {
      "type": "remote",
      "url": "https://mcp.svelte.dev/mcp",
      "description": "Svelte 5 & SvelteKit official documentation + autofixer. Obligatoire pour 🎨 SVELTE."
    },
    "rust": {
      "type": "local",
      "command": "rust-mcp-server",
      "args": [
        "--workspace",
        "./backend"
      ],
      "description": "Cargo tools (check, build, test, clippy, fmt). Requis : cargo install rust-mcp-server."
    },
    "rust-analyzer": {
      "type": "local",
      "command": "mcp-language-server",
      "args": [
        "--workspace",
        "./backend",
        "--lsp",
        "rust-analyzer"
      ],
      "description": "rust-analyzer LSP (definitions, references, diagnostics). Requis : rustup component add rust-analyzer + go install github.com/isaacphi/mcp-language-server@latest."
    }
  },
  "git": {
    "coAuthoredBy": false,
    "commitMessagePrefix": ""
  },
  "delivery": {
    "svelteFiles": "txt",
    "tsFiles": "txt",
    "rustFiles": "inline",
    "sqlFiles": "inline",
    "alwaysIncludePath": true,
    "mobileOptimized": true
  },
  "rules": {
    "alwaysFetchSourceBeforeEdit": true,
    "neverPartialDiff": true,
    "updateClaudeDocsAfterSession": true,
    "readBugsBeforeIntervention": true,
    "svelteAutoFixerBeforeDelivery": true
  },
  "environment": {
    "homeserver": "Zimaboard 832",
    "prodPort": 6300,
    "devPort": 5173,
    "dockerRegistry": "ghcr.io/mx10-ac2n/nook"
  }
}
