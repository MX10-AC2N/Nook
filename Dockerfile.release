# ============================================================
# Nook — Backend (runtime only, pre-compiled binary)
# ============================================================
# Accepte un binaire pré-compilé pour amd64 ou arm64
# Compatible Alpine — zero Google dependency
# ============================================================

# ── ÉTAPE 1 : Préparer les libs runtime ────────────────────────
FROM alpine:3.21 AS runtime

RUN apk add --no-cache \
    libstdc++ \
    libgcc \
    ca-certificates \
    sqlite-libs \
    libsodium

# Dossiers applicatifs
RUN mkdir -p /app/data /app/static /app/logs

# ── ÉTAPE 2 : Copier le binaire ───────────────────────────────
# Le binaire DOIT être compilé pour musl (compatible Alpine)
ARG TARGETARCH=amd64
COPY --chmod=755 ./artifacts/nook-backend-${TARGETARCH} /app/nook-backend

COPY frontend/build /app/static 2>/dev/null || true

WORKDIR /app

EXPOSE 3000

ENV DATA_DIR=/app/data
ENV STATIC_DIR=/app/static
ENV LOG_DIR=/app/logs

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/health || exit 1

# Nook tourne sans privileges (Alpine nobody = 65534)
RUN chmod 755 /app \
    && mkdir -p /app/data/uploads /app/logs /app/static \
    && chmod -R 777 /app/data /app/logs /app/static /app/nook-backend

ENTRYPOINT ["/app/nook-backend"]
