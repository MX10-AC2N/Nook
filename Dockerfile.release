# ============================================================
# Nook - Backend (runtime only, pre-compiled binary)
# ============================================================
# Consomme le binaire musl compile par Backend.yml
# Zero Google dependency — Alpine 3.21 (~15MB)
# ============================================================

FROM alpine:3.21 AS runtime

RUN apk add --no-cache \
    sqlite-libs \
    libsodium \
    ca-certificates

# User non-root
RUN addgroup -S nook && adduser -S nook -G nook

# Dossiers applicatifs
RUN mkdir -p /app/data/uploads /app/logs /app/static \
    && chown -R nook:nook /app

ARG TARGETARCH=amd64
COPY --chmod=755 ./artifacts/nook-backend-${TARGETARCH} /app/nook-backend
COPY frontend/build /app/static 2>/dev/null || true

WORKDIR /app

EXPOSE 3000

ENV DATA_DIR=/app/data
ENV STATIC_DIR=/app/static
ENV LOG_DIR=/app/logs

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/health || exit 1

USER nook

ENTRYPOINT ["/app/nook-backend"]
