# Nook - Backend (runtime only, pre-compiled binary)
# Using Ubuntu 24.04 to match GitHub Actions (ubuntu-latest) GLIBC 2.39
FROM ubuntu:24.04 AS runtime

RUN apt-get update && apt-get install -y \
    libsqlite3-0 \
    libsodium23 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 nook && useradd -m -u 1000 -g nook nook

RUN mkdir -p /app/data/uploads /app/logs /app/static \
    && chown -R nook:nook /app \
    && chmod 0750 /app/data /app/data/uploads /app/logs /app/static

ARG TARGETARCH=amd64
COPY --chmod=755 backend/nook-backend-${TARGETARCH} /app/nook-backend
COPY frontend/ /app/static/

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

WORKDIR /app

EXPOSE 3000

ENV DATA_DIR=/app/data
ENV STATIC_DIR=/app/static
ENV LOG_DIR=/app/logs

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:3000/api/health || exit 1

USER nook:nook

ENTRYPOINT ["/app/docker-entrypoint.sh"]
