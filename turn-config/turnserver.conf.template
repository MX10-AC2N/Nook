[turn]
# TURN server config for turn-rs
secret = "${TURN_SECRET}"
realm = "nook.app"
listening-port = 3478
tls-listening-port = 5349
lt-cred-mech = true
sp = true

# ICE servers (P0.6: ICE servers missing)
# These are advertised to WebRTC clients via the API
ice-servers = [
  { urls = ["stun:stun.l.google.com:19302", "stun:stun1.l.google.com:19302"] },
  { urls = ["turn:${PUBLIC_IP:127.0.0.1}:3478"], secret = "${TURN_SECRET}", username = "nook" }
]

# Logging
log-level = "info"
no-tcp = false
no-udp = false
